{
  "name": "dotx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DOTX — Premium Windows Browser + Official Website",
  "workspaces": [
    "apps/website",
    "apps/desktop",
    "packages/shared"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=apps/website",
    "build:website": "npm run build --workspace=apps/website",
    "preview:website": "npm run preview --workspace=apps/website",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
